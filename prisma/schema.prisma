// Game Checker schema.
// - Auth.js (NextAuth v5) adapter models: User, Account, Session, VerificationToken
// - App models: ConsoleProfile (a saved Android handheld), SavedGame (wishlist)
// Docs: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Set for local (email/password) accounts; null for OAuth-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  consoles ConsoleProfile[]
  saved    SavedGame[]
  steam    SteamProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// A user's saved Android handheld console. Mirrors an EmuReady device plus a
/// cached snapshot of its hardware so we can match listings and prefill
/// GameNative links without re-fetching the device every render.
model ConsoleProfile {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String // EmuReady device id
  /// EmuReady SoC id. Null on rows saved before this column existed; backfilled
  /// lazily by resolveConsoleRef(). Preferred over socName for chipset matching.
  socId        String?
  modelName    String
  brandName    String
  socName      String?
  gpuModel     String?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

/// A game a user wants to check later (wishlist). Caches title/art so the
/// library renders without an extra EmuReady round-trip.
model SavedGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String // EmuReady game id
  title     String
  boxartUrl String?
  systemName String?
  /// Where this save came from: "manual" (the ☆ button) or "steam" (import).
  source    String   @default("manual")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
}

/// A linked Steam account (one per user). Kept out of `User` so disconnecting is
/// a single cascading delete and the Auth.js-shaped User table stays untouched.
model SteamProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  steamId64   String    @unique // 17-digit SteamID64
  vanityUrl   String? // the /id/<vanity> slug, when that's how they linked
  personaName String?
  avatarUrl   String?
  /// Null until the first successful import; also throttles re-syncs.
  syncedAt    DateTime?
  /// game_count from the last GetOwnedGames response.
  gameCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  games SteamGame[]

  @@index([userId])
}

/// One owned Steam game, per user. A mirror of IPlayerService/GetOwnedGames:
/// re-synced wholesale, never hand-edited except for `selected`.
model SteamGame {
  id              String    @id @default(cuid())
  profileId       String
  /// Denormalized so per-user reads never join through SteamProfile.
  userId          String
  appId           Int
  name            String
  playtimeMinutes Int       @default(0)
  lastPlayedAt    DateTime?
  /// Steam's icon hash; the URL is derived (see steamIconUrl()).
  iconHash        String?
  /// True when the user ticked this game during import ("I've played this").
  selected        Boolean   @default(false)
  createdAt       DateTime  @default(now())

  profile SteamProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  app     SteamApp     @relation(fields: [appId], references: [appId])

  @@unique([userId, appId])
  @@index([userId, playtimeMinutes(sort: Desc)])
  @@index([appId])
}

/// Global, user-independent cache for one Steam app: store metadata from the
/// rate-limited appdetails endpoint plus the EmuReady game we matched it to.
/// Shared across every user who owns the app, so a popular title resolves once.
model SteamApp {
  appId            Int       @id
  name             String
  /// Store genres ("Action", "RPG", …), fetched with l=english so the strings are
  /// stable across locales. Empty until detailsFetchedAt is set.
  genres           String[]
  categories       String[]
  /// Set once appdetails has been attempted — including failures, so a delisted
  /// app is negatively cached instead of retried forever.
  detailsFetchedAt DateTime?
  /// Matched EmuReady game (Windows catalog), or null when we looked and missed.
  emuGameId        String?
  emuTitle         String?
  /// Set whenever a match was attempted, even if emuGameId stayed null.
  matchedAt        DateTime?
  updatedAt        DateTime  @updatedAt

  owners SteamGame[]

  @@index([detailsFetchedAt])
  @@index([matchedAt])
}
